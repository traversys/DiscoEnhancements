{
  "manifest_version": 3,

  "name": "Disco Enhancements for BMC Discovery (DEV)",
  "description": "This exension provides some powerful enhancements to the BMC Discovery UI.",
  "version": "1.6",
  "author": "Wes Moskal-Fitzpatrick (Traversys)",
  "short_name": "Disco Enhancements",

  "icons": {
    "128": "images/icon128.png"
  },

  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],

  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },

  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["content.js"]
  }],

  "web_accessible_resources": [
    "genericquery.html"
  ],

  "action": {
    "default_title": "Disco Enhancements",
    "default_icon": {
      "16": "images/icon.png",
      "48": "images/icon.png",
      "128": "images/icon128.png"
    },
    "default_popup": "popup.html"
  }

}
